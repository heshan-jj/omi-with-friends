  "narrative": {
    "northStar": "The private card table",
    "overview": "The private card table is the established visual anchor: deep green felt, warm ivory cards, saffron actions, compact humanist controls and expressive serif display. Rounded table silhouettes and overlapping cards provide the material character.\n\nThe interface prioritizes readable cards and clear state. The light entry surface and dark playing surface share the same typography and control shapes; contextual gold emphasis connects invitations, readiness and legal play.",
    "keyCharacteristics": [
      "Warm paper against deep green felt.",
      "Serif expression paired with compact sans-serif controls.",
      "Recognizable card faces, overlapping hands and anchored seats.",
      "Visible keyboard focus and reduced-motion support.",
      "Sticky trump context and text-labeled trump cards, with direct state and action guidance."
    ],
    "rules": [],
    "dos": [
      "Do use the established serif for display text and card ranks, and the sans-serif for controls and metadata.",
      "Do preserve the distinction between red suits and dark suits, including their suit shapes.",
      "Do keep visible focus outlines and the reduced-motion behavior on interactive cards and buttons.",
      "Do keep game status, team scores and player state visually distinct from the playing cards."
    ],
    "donts": [
      "Don't expose opponents\u2019 card faces; use the patterned backs.",
      "Don't replace disabled hand-card dimming with the general button opacity treatment.",
      "Don't add decorative motion that bypasses the existing reduced-motion preference."
    ]
  }
}
