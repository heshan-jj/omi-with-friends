      "css": ".ds-card{display:block;position:relative;width:96px;height:138px;border-radius:9px;background:#fffaf0;color:var(--red,#b64435);box-shadow:0 6px 10px #082e2530;user-select:none;}.ds-corner{position:absolute;top:8px;left:9px;display:flex;flex-direction:column;align-items:center;gap:2px;}.ds-corner b{font-family:var(--serif,\"Bodoni Moda\",Georgia,serif);font-size:22px;font-weight:600;line-height:1.1;}.ds-corner svg{width:13px;height:13px;}.ds-bottom{top:auto;left:auto;bottom:8px;right:9px;transform:rotate(180deg);}.ds-pip{position:absolute;width:39px;height:39px;left:50%;top:50%;transform:translate(-50%,-50%);}.ds-pip svg{width:100%;height:100%;}"
